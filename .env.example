# PostgreSQL Database
DATABASE_URL=postgresql://airline_user:airline_secret@localhost:5432/airline_db
DATABASE_REPLICA_URL=postgresql://airline_user:airline_secret@localhost:5432/airline_db

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=airline-platform

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# OpenTelemetry & Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logging
LOG_LEVEL=info

# Service Ports
PORT_AUTH_SERVICE=4001
PORT_ADMIN_SERVICE=4002
PORT_INVENTORY_SERVICE=4003
PORT_SEARCH_SERVICE=4004
PORT_BOOKING_SERVICE=4005
PORT_PAYMENT_SERVICE=4006
PORT_NOTIFICATION_SERVICE=4007
